# Copy to .env and adjust for your environment.

APP_NAME=Industrial Maintenance Agent
APP_VERSION=0.8.3
ENVIRONMENT=development
DEBUG=true
# Verbosity for the "app" logger namespace. An unknown value fails at startup.
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

# Persistence
DATABASE_URL=sqlite:///./data/industrial_maintenance.db
AUTO_CREATE_TABLES=true

# --- Planner selection ---
# rule = frozen deterministic planner (default, no LLM)
# llm  = LLM planner only; a failure is reported, never silently downgraded
# auto = LLM planner first, then the rule planner if the LLM cannot plan
PLANNER_MODE=rule

# --- LLM provider (only needed when PLANNER_MODE is llm or auto) ---
# The provider is any OpenAI-compatible chat completions endpoint. The field
# below is the API root, for example https://api.example.com/v1. No host is
# assumed by default: with nothing configured the LLM planner reports a provider
# error rather than guessing an endpoint.
LLM_BASE_URL=
# Secret. Never commit a real value and never log it.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0

# --- RAG integration (Industrial Knowledge RAG, consumed read-only) ---
# Provider selection:
#   local = run the RAG retrieval engine in-process (LLM-free, needs a checkout)
#   http  = call the RAG FastAPI service (needs a running service)
RAG_PROVIDER=local

# Required for RAG_PROVIDER=local. Point this at your RAG repository root.
# No default path is assumed by the application.
RAG_REPO_ROOT=

# RAG backend module: light (light_rag_core) or full (rag_core).
RAG_BACKEND=light
# Knowledge base identifier registered inside the RAG service.
RAG_KNOWLEDGE_BASE_ID=default
# lexical | vector | hybrid
RAG_RETRIEVAL_MODE=hybrid
# Default hit limit for search_maintenance_manual.
RAG_TOP_K=4

# Required for RAG_PROVIDER=http, for example http://127.0.0.1:8000
# No default host or port is assumed by the application.
RAG_BASE_URL=
RAG_TIMEOUT_SECONDS=10
# POST /ask always runs the RAG service's own answer generator upstream.
# The agent consumes the retrieval evidence only and discards the answer.
RAG_HTTP_MODEL_PROVIDER=DeepSeek
