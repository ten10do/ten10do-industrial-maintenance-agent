# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Virtual environments
.venv/
.venv-broken-*/
venv/
env/

# Local data / databases
data/*.db
data/*.sqlite
*.db
*.sqlite

# External datasets. The MetroPT-3 CSV is about 208 MiB and is not ours to
# redistribute; it must never enter Git history. The directory itself is kept
# (it holds the README and .gitkeep) but every payload is ignored. See
# docs/data/metropt3.md.
data/external/metropt3/*.csv
data/external/metropt3/*.zip
data/external/metropt3/*.pdf

# Logs
*.log

# Secrets and local config. Every env file is ignored except the placeholder
# template, so a stray ".env.txt" or ".env.backup" cannot be committed.
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/

# Assistant workspace state (session notes and local memory). Internal working
# state rather than a software artifact, and it changes on every session, so it
# is kept out of the tree.
.workbuddy/

# OS
Thumbs.db
.DS_Store
