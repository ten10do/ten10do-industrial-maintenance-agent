# Build context exclusions. Keep the context free of secrets, VCS data, caches
# and local working state.

# Version control
.git
.gitignore

# Local environment and secrets. Only the placeholder template is allowed
# through, and the Dockerfile does not copy it into the image.
.env
.env.*
!.env.example

# Virtual environments
.venv
.venv-broken-*
venv
env

# Python caches and build output
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Local data and logs (the seed JSON files stay in context)
*.db
*.sqlite
*.log
data/*.db

# Externally sourced datasets. These are large, licensed to their publisher
# rather than to this project, and mounted read-only at run time instead of being
# shipped. A 208 MiB copy inside the build context would be baked into the image
# by any directory-wide COPY and would slow every build. The runtime data files
# (devices.json, alarms.json) are copied by name, so this exclusion cannot remove
# anything the service needs.
data/external
**/*.zip

# Assistant workspace state
.workbuddy

# Container and documentation files are not needed inside the image
Dockerfile
.dockerignore
docker-compose.yml
docs

# OS noise
Thumbs.db
.DS_Store
